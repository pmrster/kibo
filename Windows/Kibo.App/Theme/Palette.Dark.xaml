<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme.swift, dark side. Same keys as Palette.Light.xaml, always. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#1C1A17" />
    <SolidColorBrush x:Key="Brush.PanelEdge" Color="#2A2620" />
    <SolidColorBrush x:Key="Brush.Text" Color="#EDE6DC" />
    <SolidColorBrush x:Key="Brush.Dim" Color="#9A8F84" />
    <SolidColorBrush x:Key="Brush.Track" Color="#3A352E" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#EDE9E1" />
    <SolidColorBrush x:Key="Brush.Green" Color="#10A37F" />
    <SolidColorBrush x:Key="Brush.Kibo" Color="#F2EEE6" />
    <SolidColorBrush x:Key="Brush.FieldFill" Color="#221F1B" />

    <SolidColorBrush x:Key="Brush.Accent15" Color="#EDE9E1" Opacity="0.15" />
    <SolidColorBrush x:Key="Brush.Accent18" Color="#EDE9E1" Opacity="0.18" />
    <SolidColorBrush x:Key="Brush.Green12" Color="#10A37F" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.Green15" Color="#10A37F" Opacity="0.15" />
    <SolidColorBrush x:Key="Brush.Dim12" Color="#9A8F84" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.Dim40" Color="#9A8F84" Opacity="0.40" />
    <SolidColorBrush x:Key="Brush.PanelEdge70" Color="#2A2620" Opacity="0.70" />
</ResourceDictionary>
