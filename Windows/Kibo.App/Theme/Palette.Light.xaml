<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme.swift, light side: Tama's warm neutrals under a near-monochrome accent that matches
         the mascot. Keep the two palettes key-for-key identical; ThemeManager swaps whole files. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#F7F4EF" />
    <SolidColorBrush x:Key="Brush.PanelEdge" Color="#E0DAD0" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1C1A17" />
    <SolidColorBrush x:Key="Brush.Dim" Color="#6E655C" />
    <SolidColorBrush x:Key="Brush.Track" Color="#D8D2C8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#24262F" />
    <SolidColorBrush x:Key="Brush.Green" Color="#0E8A6B" />
    <!-- The mascot: midnight on light, pale on dark — always the opposite of what it sits on. -->
    <SolidColorBrush x:Key="Brush.Kibo" Color="#1E202C" />
    <!-- Opaque on purpose: the mascot perches with its tails behind the input field, and a
         translucent fill would show them through. -->
    <SolidColorBrush x:Key="Brush.FieldFill" Color="#EDE8E1" />

    <!-- The tints SwiftUI made with .opacity(), as their own brushes. -->
    <SolidColorBrush x:Key="Brush.Accent15" Color="#24262F" Opacity="0.15" />
    <SolidColorBrush x:Key="Brush.Accent18" Color="#24262F" Opacity="0.18" />
    <SolidColorBrush x:Key="Brush.Green12" Color="#0E8A6B" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.Green15" Color="#0E8A6B" Opacity="0.15" />
    <SolidColorBrush x:Key="Brush.Dim12" Color="#6E655C" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.Dim40" Color="#6E655C" Opacity="0.40" />
    <SolidColorBrush x:Key="Brush.PanelEdge70" Color="#E0DAD0" Opacity="0.70" />
</ResourceDictionary>
