<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# twin of Tests/KiboCoreTests: one class per Swift test file, the same fixture, the
       same accuracy figures. Runs on macOS with `dotnet test Windows/Kibo.Core.Tests`. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kibo.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xunit v3 on Microsoft.Testing.Platform, which is what the .NET 10 SDK's `dotnet test`
         runs (the opt-in is the "test" block in global.json). The project is its own executable. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kibo.Core/Kibo.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- The IDE adapter, so Visual Studio and Rider list the tests; not needed by `dotnet test`. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
