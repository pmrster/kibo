# Keep stray Finder metadata out. Packaging/dmg.DS_Store (if added later) is a deliberately
# named deterministic DMG layout artifact, not a local Finder .DS_Store.
.DS_Store
.build/
*.xcodeproj
.swiftpm/
DerivedData/
*.xcworkspace/
xcuserdata/
*.xcuserstate

*.dmg
dist/

.superpowers/
state/

*.log
*.tmp
*.swp
*.swo
__pycache__/
*.pyc

/.env
.env
.env.*

*.pem
*.p12
*.key
*.mobileprovision
*.xcconfig

/.cache/
/.agents/
/.codex/

# Design-review output from `--snapshot`, which defaults to ./assets. Regenerated on demand and
# never reviewed as source. The two screenshots the README uses live in docs/ and ARE tracked.
assets/

# Generated during packaging from icon.png; nothing to commit.
Packaging/icon-1024.png
Packaging/AppIcon.icns

# Claude Code local worktrees
.claude/worktrees/

# Brand kit, website copy and the pitch-deck template. Local-only on purpose: the repo is going
# public and the marketing material is not part of the source.
brand/
