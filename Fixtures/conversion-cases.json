  "cases": [
    {
      "name": "spec: english keystrokes become thai",
      "mode": "englishToThai",
      "input": "vpkddbodkca",
      "output": "อยากกินกาแฟ"
    },
    {
      "name": "spec: thai keystrokes become english",
      "mode": "thaiToEnglish",
      "input": "ะ้ฟืา",
      "output": "thank"
    },
    {
      "name": "spec: greeting typed on the wrong layout",
      "mode": "englishToThai",
      "input": "l;ylfu",
      "output": "สวัสดี"
    },
    {
      "name": "spec: english word typed on the thai layout",
      "mode": "thaiToEnglish",
      "input": "ไำะ",
      "output": "wet"
    },
    {
      "name": "every unshifted letter key",
      "mode": "englishToThai",
      "input": "abcdefghijklmnopqrstuvwxyz",
      "output": "ฟิแกำดเ้ร่าสทืนยๆพหะีอไปัผ"
    },
    {
      "name": "every shifted letter key",
      "mode": "englishToThai",
      "input": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
      "output": "ฤฺฉฏฎโฌ็ณ๋ษศ?์ฯญ๐ฑฆธ๊ฮ\")ํ("
    },
    {
      "name": "every digit and unshifted punctuation key",
      "mode": "englishToThai",
      "input": "`1234567890-=[]\\;',./",
      "output": "-ๅ/_ภถุึคตจขชบลฃวงมใฝ"
    },
    {
      "name": "every shifted punctuation key",
      "mode": "englishToThai",
      "input": "~!@#$%^&*()_+{}|:\"<>?",
      "output": "%+๑๒๓๔ู฿๕๖๗๘๙ฐ,ฅซ.ฒฬฦ"
    },
    {
      "name": "round trip: thai side of the full table",
      "mode": "thaiToEnglish",
      "input": "ฟิแกำดเ้ร่าสทืนยๆพหะีอไปัผ",
      "output": "abcdefghijklmnopqrstuvwxyz"
    },
    {
      "name": "empty input",
      "mode": "englishToThai",
      "input": "",
      "output": ""
    },
    {
      "name": "whitespace and newlines survive",
      "mode": "englishToThai",
      "input": " \n\n\t ",
      "output": " \n\n\t "
    },
    {
      "name": "emoji and other scripts survive",
      "mode": "englishToThai",
      "input": "🐈🇹🇭 日本 café",
      "output": "🐈🇹🇭 日本 แฟดé"
    },
    {
      "name": "text already in the destination script is left alone",
      "mode": "englishToThai",
      "input": "สวัสดี",
      "output": "สวัสดี"
    },
    {
      "name": "multiline input keeps its line structure",
      "mode": "englishToThai",
      "input": "l;ylfu\nl;ylfu\n\nl;ylfu",
      "output": "สวัสดี\nสวัสดี\n\nสวัสดี"
    },
    {
      "name": "mixed: the worked example",
      "mode": "mixed",
      "input": "l;ylfu ไำะ ครับ 2024 :)",
      "output": "สวัสดี wet ครับ 2024 :)"
    },
    {
      "name": "mixed: correct text of both scripts is left alone",
      "mode": "mixed",
      "input": "ครับ hello",
      "output": "ครับ hello"
    },
    {
      "name": "mixed: each run converts in its own direction",
      "mode": "mixed",
      "input": "l;ylfu ไำะ",
      "output": "สวัสดี wet"
    },
    {
      "name": "mixed: numbers and punctuation are never touched",
      "mode": "mixed",
      "input": "2024 :) 3.14 100%",
      "output": "2024 :) 3.14 100%"
    },
    {
      "name": "mixed: neutral runs pass through",
      "mode": "mixed",
      "input": "l;ylfu\n🐈 ครับ",
      "output": "สวัสดี\n🐈 ครับ"
    },
    {
      "name": "mixed: letter-poor thai wreckage is still caught",
      "mode": "mixed",
      "input": "-v[86I",
      "output": "ขอบคุณ"
    },
    {
      "name": "mixed: empty input",
      "mode": "mixed",
      "input": "",
      "output": ""
    },
    {
      "name": "known limitation: well-formed thai wreckage is kept",
      "mode": "mixed",
      "input": "แนกำ",
      "output": "แนกำ"
    },
    {
      "name": "known limitation: mistyping that collides with a real word is kept",
      "mode": "mixed",
      "input": "นา",
      "output": "นา"
    },
    {
      "name": "known limitation: english-shaped wreckage is kept",
      "mode": "mixed",
      "input": "Fi'giupo",
      "output": "Fi'giupo"
    }
  ]
}
